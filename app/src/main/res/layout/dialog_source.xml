<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/source_attribution_title"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/source_attribution" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="?attr/colorOutlineVariant" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/source_original_title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSourceUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/source_original_placeholder"
        android:textColor="@color/link_blue" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="?attr/colorOutlineVariant" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/source_license_title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvLicenseName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/source_license_placeholder" />

    <TextView
        android:id="@+id/tvLicenseUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/source_license_link"
        android:textColor="@color/link_blue" />

</LinearLayout>