<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="34dp"
    tools:context=".MainActivity">

    <!-- 1. Buscador: permanece visible -->
    <LinearLayout
        android:id="@+id/layoutBuscador"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etWord"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/word_hint"
            android:inputType="text"
            android:maxLines="1"
            android:imeOptions="actionSearch" />

        <ImageButton
            android:id="@+id/btnBuscar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/search_button"
            android:src="@android:drawable/ic_menu_search"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/blue"
            android:onClick="buscarPalabra" />

        <ImageButton
            android:id="@+id/btnLimpiar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/clear_button"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/red_intense"
            android:onClick="limpiarBuscador" />

    </LinearLayout>

    <!-- Mensajes de búsqueda: errores y avisos -->
    <TextView
        android:id="@+id/tvRespuesta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="14sp"
        android:accessibilityLiveRegion="polite" />

    <!-- 2. Cabecera: palabra, pronunciación y guardar -->
    <LinearLayout
        android:id="@+id/layoutCabeceraPalabra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/layoutDatosPalabra"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPalabra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="32sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvPronunciacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/btnPronunciar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/button_volume_up_24px"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/listen_pronunciation_description"
                    android:padding="8dp" />

            </LinearLayout>

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnGuardarPalabra"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/save_word"
            android:src="@android:drawable/btn_star_big_off"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/blue" />

    </LinearLayout>


    <LinearLayout
        android:id="@+id/layoutPestanas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <!-- Pestaña: definiciones -->
        <LinearLayout
            android:id="@+id/layoutTabDefiniciones"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnTabDefiniciones"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="@android:color/transparent"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:text="@string/tab_definitions"
                android:textAllCaps="false"
                android:textColor="@color/tab_text_color"
                android:textSize="12sp"
                android:padding="2dp" />

            <View
                android:id="@+id/indicadorDefiniciones"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="@drawable/tab_indicator_selected" />

        </LinearLayout>

        <!-- Pestaña: sinónimos -->
        <LinearLayout
            android:id="@+id/layoutTabSinonimos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnTabSinonimos"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="@android:color/transparent"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:text="@string/tab_synonyms"
                android:textAllCaps="false"
                android:textColor="@color/tab_text_color"
                android:textSize="12sp"
                android:padding="2dp" />

            <View
                android:id="@+id/indicadorSinonimos"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="@drawable/tab_indicator_selected"
                android:visibility="invisible" />

        </LinearLayout>

        <!-- Pestaña: formas gramaticales -->
        <LinearLayout
            android:id="@+id/layoutTabFormas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnTabFormas"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="@android:color/transparent"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:text="@string/tab_forms"
                android:textAllCaps="false"
                android:textColor="@color/tab_text_color"
                android:textSize="12sp"
                android:padding="2dp" />

            <View
                android:id="@+id/indicadorFormas"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="@drawable/tab_indicator_selected"
                android:visibility="invisible" />

        </LinearLayout>

    </LinearLayout>

    <!-- 4. Área desplazable de definiciones y ejemplos -->
    <ScrollView
        android:id="@+id/scrollDefiniciones"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/layoutDefiniciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp">

            <!-- MainActivity añadirá aquí los bloques de definiciones -->

        </LinearLayout>

    </ScrollView>

    <!-- 5. Área desplazable de sinónimos y antónimos -->
    <ScrollView
        android:id="@+id/scrollSinonimos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:id="@+id/layoutSinonimos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tvTituloSinonimos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/synonyms_label"
                android:textColor="@color/chip_synonym_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutEtiquetasSinonimos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start"
                android:paddingTop="8dp" />

            <TextView
                android:id="@+id/tvTituloAntonimos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/antonyms_label"
                android:textColor="@color/chip_antonym_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutEtiquetasAntonimos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start"
                android:paddingTop="8dp" />

        </LinearLayout>

    </ScrollView>

    <!-- 6. Área desplazable de formas gramaticales -->
    <ScrollView
        android:id="@+id/scrollFormas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:id="@+id/layoutFormas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp">

            <!-- MainActivity añadirá aquí las formas gramaticales -->

        </LinearLayout>

    </ScrollView>

</LinearLayout>
